# 이 파일을 ".env" 로 복사해서 사용합니다. (.env 는 Git 에 올리지 않습니다)
# 아래 값은 "내 PC 의 PostgreSQL 컨테이너" 전용 예시입니다. 서버 접속 정보는 절대 쓰지 마세요.

# local / dev / prod
APP_ENV=local

# 내 PC 의 PostgreSQL 컨테이너(docker compose)가 쓰는 값 (내 PC 에서만 쓰는 연습용)
POSTGRES_USER=app
POSTGRES_PASSWORD=local_only_password
POSTGRES_DB=app

# DB 접속 주소 (위 값과 맞춰야 합니다)
DATABASE_URL=postgresql+psycopg://app:local_only_password@127.0.0.1:5433/app
